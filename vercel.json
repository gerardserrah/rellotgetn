{
  "version": 2,
  "name": "rellotgetn",
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    }
  },
  "routes": [
    {
      "src": "^/fonts/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/audio/(.*)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/(1996|1999|2001|2002|2005|2014|2025)/?$",
      "dest": "/api/index.js?any=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
