{
  "version": 2,
  "name": "rellotgetn",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/1999", "destination": "/index.html?mode=1999" },
    { "source": "/2001", "destination": "/index.html?mode=1999" },
    { "source": "/2002", "destination": "/index.html?mode=2002" },
    { "source": "/2005", "destination": "/index.html?mode=2005" },
    { "source": "/2014", "destination": "/index.html?mode=2014" },
    { "source": "/2025", "destination": "/index.html?mode=2025" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
